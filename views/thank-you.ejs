<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Courier Co enquiry confirmation page.">
    <title>Courier Co | Thank You</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/png" href="/images/favicon-16x16.png">
</head>
<body>
    <header class="navbar">
        <div class="site-title">
            <a href="/">Courier Co</a>
        </div>

        <input type="checkbox" id="menu-checkbox" hidden>
        <label for="menu-checkbox" class="menu-toggle" aria-label="Open menu">☰</label>

        <nav aria-label="Main navigation">
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/services">Services</a></li>
                <li><a href="/enquiries">Enquiries &amp; Contact</a></li>
            </ul>
        </nav>
    </header>

    <main class="thank-you-page">
        <section class="thank-you-message">
            <p class="eyebrow">Enquiry received</p>
            <h1>Thank you for your enquiry</h1>
            <p>Your request has been submitted successfully.</p>
            <p>
                A member of the Courier Co team will review your details and contact you
                as soon as possible with the most suitable delivery option.
            </p>

            <% if (enquiryData) { %>
                <section class="enquiry-summary">
                    <h2>Your submitted details</h2>
                    <div class="summary-grid">
                        <div class="summary-row">
                            <span>Full Name</span>
                            <strong><%= enquiryData.fullName %></strong>
                        </div>
                        <div class="summary-row">
                            <span>Email</span>
                            <strong><%= enquiryData.email %></strong>
                        </div>
                        <div class="summary-row">
                            <span>Phone</span>
                            <strong><%= enquiryData.phone %></strong>
                        </div>
                        <div class="summary-row">
                            <span>Service</span>
                            <strong><%= enquiryData.service %></strong>
                        </div>
                        <div class="summary-row">
                            <span>Delivery Priority</span>
                            <strong><%= enquiryData.deliveryType %></strong>
                        </div>
                        <div class="summary-row">
                            <span>Collection Date</span>
                            <strong><%= enquiryData.collectionDate %></strong>
                        </div>
                        <div class="summary-row">
                            <span>Weight</span>
                            <strong><%= enquiryData.weight %> kg</strong>
                        </div>
                        <div class="summary-row summary-row-message">
                            <span>Delivery Details</span>
                            <strong><%= enquiryData.message %></strong>
                        </div>
                    </div>
                </section>
            <% } %>

            <p class="thank-you-links">
                <a href="/" class="btn">Return to Home</a>
                <a href="/services" class="btn btn-secondary">View Our Services</a>
            </p>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-left">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer">X</a>
        </div>

        <div class="footer-center">
            <p>&copy; 2026 Courier Co</p>
        </div>

        <div class="footer-right">
            <img src="/images/courier-co.jpg" alt="Courier Co logo" class="footer-logo">
        </div>

        <div class="footer-credits">
            <p>
                Images courtesy of
                <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a>
                and
                <a href="https://www.freepik.com/" target="_blank" rel="noopener noreferrer">Freepik</a>.
                Favicon from
                <a href="https://favicon.io/" target="_blank" rel="noopener noreferrer">favicon.io</a>.
            </p>
        </div>
    </footer>
</body>
</html>