<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courier Co | Services</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/png" href="/images/favicon-16x16.png">
</head>
<body>
    <header class="navbar">
        <div class="site-title">
  <a href="/">Courier Co</a>
</div>

        <input type="checkbox" id="menu-checkbox" hidden>
        <label for="menu-checkbox" class="menu-toggle">☰</label>

        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/services">Services</a></li>
                <li><a href="/enquiries">Enquiries & Contact</a></li>
            </ul>
        </nav>
    </header>

    <main>
    <section class="services-intro">
        <h1>Our Courier Services</h1>
        <p>
            Courier Co provides reliable local delivery services for individuals
            and businesses. Whether you need a one-off delivery or regular courier
            support, we have a service to suit your needs.
        </p>
    </section>

    <section class="services-list">
        <h2>Same-Day Delivery</h2>
        <p>
            Fast and reliable same-day courier services for urgent deliveries
            within the local area.
        </p>

        <h2>Scheduled Delivery</h2>
        <p>
            Book collections and deliveries in advance for planned logistics
            and regular shipments.
        </p>

        <h2>Business Courier Services</h2>
        <p>
            Dedicated courier solutions for businesses needing reliable and
            consistent parcel delivery.
        </p>

        <h2>Collection & Drop-Off</h2>
        <p>
            We collect parcels from your location and deliver them safely
            to their destination.
        </p>
    </section>

    <section class="services-cta">
        <h2>Get a Quote</h2>
        <p>
            Need a delivery? <a href="/enquiries">Send us an enquiry</a>
            and we'll get back to you with a quote.
        </p>
    </section>
</main>

    <footer class="site-footer">
        <div class="footer-left">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer">X</a>
        </div>

        <div class="footer-center">
            <p>&copy; 2026 Courier Co</p>
        </div>

        <div class="footer-right">
            <img src="/images/courier-co.jpg" alt="Courier Co logo" class="footer-logo">
        </div>

        <div class="footer-credits">
            <p>
                Images courtesy of
                <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a>
                and
                <a href="https://www.freepik.com/" target="_blank" rel="noopener noreferrer">Freepik</a>.
                Favicon from
                <a href="https://favicon.io/" target="_blank" rel="noopener noreferrer">favicon.io</a>.
            </p>
        </div>
    </footer>
