<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Request a courier quote from Courier Co for same-day, scheduled, and business delivery services.">
    <title>Courier Co | Enquiries & Contact</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/png" href="/images/favicon-16x16.png">
</head>
<body>
    <header class="navbar">
        <div class="site-title">
            <a href="/">Courier Co</a>
        </div>

        <input type="checkbox" id="menu-checkbox" hidden>
        <label for="menu-checkbox" class="menu-toggle" aria-label="Open menu">☰</label>

        <nav aria-label="Main navigation">
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/services">Services</a></li>
                <li><a href="/enquiries">Enquiries &amp; Contact</a></li>
            </ul>
        </nav>
    </header>

    <main class="enquiry-page">
        <section class="enquiry-intro">
            <p class="eyebrow">Request a tailored quote</p>
            <h1>Enquiries &amp; Contact</h1>
            <p>
                Need a delivery, collection, or business courier service? Complete the form below and we will review your
                request and respond with the most suitable option.
            </p>
        </section>

        <section class="enquiry-form-section">
            <form class="enquiry-form" action="/enquiries" method="post" novalidate>
                <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input
                        type="text"
                        id="fullName"
                        name="fullName"
                        value="<%= formData.fullName || '' %>"
                    >
                    <% if (errors.fullName) { %>
                        <p class="form-error"><%= errors.fullName %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= formData.email || '' %>"
                    >
                    <% if (errors.email) { %>
                        <p class="form-error"><%= errors.email %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="e.g. 07123 456789"
                        value="<%= formData.phone || '' %>"
                    >
                    <% if (errors.phone) { %>
                        <p class="form-error"><%= errors.phone %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="service">Service Required</label>
                    <select id="service" name="service">
                        <option value="">Please select</option>
                        <option value="Same-day courier" <%= formData.service === 'Same-day courier' ? 'selected' : '' %>>Same-Day Courier</option>
                        <option value="Scheduled delivery" <%= formData.service === 'Scheduled delivery' ? 'selected' : '' %>>Scheduled Delivery</option>
                        <option value="Business courier" <%= formData.service === 'Business courier' ? 'selected' : '' %>>Business Courier</option>
                        <option value="Collection and drop-off" <%= formData.service === 'Collection and drop-off' ? 'selected' : '' %>>Collection &amp; Drop-off</option>
                        <option value="Other" <%= formData.service === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                    <% if (errors.service) { %>
                        <p class="form-error"><%= errors.service %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="deliveryType">Delivery Priority</label>
                    <select id="deliveryType" name="deliveryType">
                        <option value="">Please select</option>
                        <option value="Same-day" <%= formData.deliveryType === 'Same-day' ? 'selected' : '' %>>Same-day</option>
                        <option value="Next-day" <%= formData.deliveryType === 'Next-day' ? 'selected' : '' %>>Next-day</option>
                        <option value="Scheduled" <%= formData.deliveryType === 'Scheduled' ? 'selected' : '' %>>Scheduled</option>
                    </select>
                    <% if (errors.deliveryType) { %>
                        <p class="form-error"><%= errors.deliveryType %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="collectionDate">Preferred Collection Date</label>
                    <input
                        type="date"
                        id="collectionDate"
                        name="collectionDate"
                        value="<%= formData.collectionDate || '' %>"
                    >
                    <% if (errors.collectionDate) { %>
                        <p class="form-error"><%= errors.collectionDate %></p>
                    <% } %>
                </div>
<div class="form-group">
    <label for="collectionPostcode">Collection Postcode</label>
    <input
        type="text"
        id="collectionPostcode"
        name="collectionPostcode"
        placeholder="e.g. SW1A 1AA"
        value="<%= formData.collectionPostcode || '' %>"
    >
    <% if (errors.collectionPostcode) { %>
        <p class="form-error"><%= errors.collectionPostcode %></p>
    <% } %>
    <p class="postcode-result" id="collectionPostcodeResult"></p>
</div>

<div class="form-group">
    <label for="deliveryPostcode">Delivery Postcode</label>
    <input
        type="text"
        id="deliveryPostcode"
        name="deliveryPostcode"
        placeholder="e.g. M1 1AE"
        value="<%= formData.deliveryPostcode || '' %>"
    >
    <% if (errors.deliveryPostcode) { %>
        <p class="form-error"><%= errors.deliveryPostcode %></p>
    <% } %>
    <p class="postcode-result" id="deliveryPostcodeResult"></p>
</div>
                <div class="form-group">
                    <label for="weight">Approximate Parcel Weight (kg)</label>
                    <input
                        type="number"
                        id="weight"
                        name="weight"
                        min="0"
                        step="0.1"
                        placeholder="e.g. 2.5"
                        value="<%= formData.weight || '' %>"
                    >
                    <% if (errors.weight) { %>
                        <p class="form-error"><%= errors.weight %></p>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="message">Delivery Details</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        placeholder="Add collection address, delivery address, parcel details, access notes, and timing requirements."
                    ><%= formData.message || '' %></textarea>
                    <% if (errors.message) { %>
                        <p class="form-error"><%= errors.message %></p>
                    <% } %>
                </div>

                <button type="submit" class="submit-btn">Send Enquiry</button>
            </form>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-left">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer">X</a>
        </div>

        <div class="footer-center">
            <p>&copy; 2026 Courier Co</p>
        </div>

        <div class="footer-right">
            <img src="/images/courier-co.jpg" alt="Courier Co logo" class="footer-logo">
        </div>

        <div class="footer-credits">
            <p>
                Images courtesy of
                <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a>
                and
                <a href="https://www.freepik.com/" target="_blank" rel="noopener noreferrer">Freepik</a>.
                Favicon from
                <a href="https://favicon.io/" target="_blank" rel="noopener noreferrer">favicon.io</a>.
            </p>
        </div>
    </footer>
    <script src="/js/script.js"></script>
</body>
</html>