<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courier Co | Enquiries & Contact</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/png" href="/images/favicon-16x16.png">
</head>
<body>
    <header class="navbar">
        <div class="site-title">
            <a href="index.html">Courier Co</a>
        </div>

        <input type="checkbox" id="menu-checkbox" hidden>
        <label for="menu-checkbox" class="menu-toggle">☰</label>

        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about.html">About Us</a></li>
                <li><a href="/services.html">Services</a></li>
                <li><a href="/enquiries.html">Enquiries & Contact</a></li>
            </ul>
        </nav>
    </header>

    <main class="enquiry-page">
        <section class="enquiry-intro">
            <h1>Enquiries & Contact</h1>
            <p>
                Need a delivery, collection, or business courier service? Fill in the form
                below and we’ll get back to you as soon as possible.
            </p>
        </section>

        <section class="enquiry-form-section">
            <form class="enquiry-form" action="thank-you.html" method="post">
                <div class="form-group">
                    <label for="customer_name">Full Name</label>
                    <input
                        type="text"
                        id="customer_name"
                        name="customer_name"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="e.g. 07123 456789"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="service">Service Required</label>
                    <select id="service" name="service" required>
                        <option value="">Please select</option>
                        <option value="same-day-delivery">Same-Day Delivery</option>
                        <option value="scheduled-delivery">Scheduled Delivery</option>
                        <option value="business-courier">Business Courier Service</option>
                        <option value="collection-dropoff">Collection & Drop-off</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="collection_address">Collection Address</label>
                    <textarea
                        id="collection_address"
                        name="collection_address"
                        rows="3"
                        required
                    ></textarea>
                </div>

                <div class="form-group">
                    <label for="delivery_address">Delivery Address</label>
                    <textarea
                        id="delivery_address"
                        name="delivery_address"
                        rows="3"
                        required
                    ></textarea>
                </div>

                <div class="form-group">
                    <label for="collection_date">Preferred Collection Date</label>
                    <input
                        type="date"
                        id="collection_date"
                        name="collection_date"
                    >
                </div>

                <div class="form-group">
                    <label for="parcel_size">Parcel Size</label>
                    <select id="parcel_size" name="parcel_size">
                        <option value="">Please select</option>
                        <option value="small">Small (max 5kg)</option>
                        <option value="medium">Medium (max 15kg)</option>
                        <option value="large">Large (max 25kg)</option>
                        <option value="oversize">Oversize (over 25kg)</option>
                        <option value="multiple">Multiple Items</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="parcel_weight">Approximate Parcel Weight (kg)</label>
                    <input
                        type="number"
                        id="parcel_weight"
                        name="parcel_weight"
                        min="0"
                        step="0.1"
                        placeholder="e.g. 2.5"
                    >
                </div>

                <div class="form-group">
                    <label for="message">Additional Details</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Add any extra details about the delivery, timing, or item(s)."
                    ></textarea>
                </div>

                <div class="form-group checkbox-group">
                    <input
                        type="checkbox"
                        id="consent"
                        name="consent"
                        required
                    >
                    <label for="consent">
                        I agree to be contacted regarding my enquiry.
                    </label>
                </div>

                <button type="submit" class="submit-btn">Send Enquiry</button>
            </form>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-left">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer">X</a>
        </div>

        <div class="footer-center">
            <p>&copy; 2026 Courier Co</p>
        </div>

        <div class="footer-right">
            <img src="/images/courier-co.jpg" alt="Courier Co logo" class="footer-logo">
        </div>

        <div class="footer-credits">
            <p>
                Images courtesy of
                <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a>
                and
                <a href="https://www.freepik.com/" target="_blank" rel="noopener noreferrer">Freepik</a>.
                Favicon from
                <a href="https://favicon.io/" target="_blank" rel="noopener noreferrer">favicon.io</a>.
            </p>
        </div>
    </footer>
</body>
</html>