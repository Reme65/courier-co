<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Courier Co</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/png" href="/images/favicon-16x16.png">
</head>
<body>
    <header class="navbar">
        <div class="site-title">
            <a href="/">Courier Co</a>
        </div>

        <input type="checkbox" id="menu-checkbox" hidden>
        <label for="menu-checkbox" class="menu-toggle">☰</label>

        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/services">Services</a></li>
                <li><a href="/enquiries">Enquiries & Contact</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="hero">
            <h1>Welcome to Courier Co</h1>
            <p>Your reliable partner for local courier and logistics services.</p>
            <p>We provide same-day, scheduled, and business delivery solutions tailored to your needs.</p>
            <p class="hero-actions">
                <a href="/services" class="btn">View Services</a>
                <a href="/enquiries" class="btn">Get a Quote</a>
            </p>
            <section class="home-services">
        <h2>Our Key Services</h2>

        <div class="services-grid">
            <div class="service-card">
                <h3>Same-Day Delivery</h3>
                <p>
                    Fast and dependable same-day courier services for urgent local
                    deliveries.
                </p>
            </div>

            <div class="service-card">
                <h3>Scheduled Delivery</h3>
                <p>
                    Flexible pre-booked collections and deliveries to suit your
                    timetable.
                </p>
            </div>

            <div class="service-card">
                <h3>Business Courier</h3>
                <p>
                    Reliable delivery support for businesses needing regular parcel
                    and document transport.
                </p>
            </div>
        </div>
        </section>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-left">
            <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer">Facebook</a>
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer">X</a>
        </div>

        <div class="footer-center">
            <p>&copy; 2026 Courier Co</p>
        </div>

        <div class="footer-right">
            <img src="/images/courier-co.jpg" alt="Courier delivery illustration" class="footer-logo">
        </div>

        <div class="footer-credits">
            <p>
                Images courtesy of
                <a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a>
                and
                <a href="https://www.freepik.com/" target="_blank" rel="noopener noreferrer">Freepik</a>.
                Favicon from
                <a href="https://favicon.io/" target="_blank" rel="noopener noreferrer">favicon.io</a>.
            </p>
        </div>
    </footer>
</body>
</html>